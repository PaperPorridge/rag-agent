# ===== LLM (小米 MiMo) =====
# 在 https://platform.xiaomimimo.com/ 创建 API Key
MIMO_API_KEY=REPLACE_WITH_YOUR_MIMO_API_KEY
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
# 思考模式：enabled 开启深度思考（默认），disabled 关闭（更快更省）
MIMO_THINKING=enabled

# ===== Embedding（M2 引入）=====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ===== 数据库（M4 引入）=====
POSTGRES_DSN=postgresql+asyncpg://knowflow:knowflow@localhost:5432/knowflow
REDIS_URL=redis://localhost:6379/0

# ===== 消息队列（M5 引入）=====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===== 向量库（M2 引入）=====
QDRANT_URL=http://localhost:6333

# ===== 应用 =====
APP_ENV=dev
LOG_LEVEL=INFO
